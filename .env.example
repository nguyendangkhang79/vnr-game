# Server-only variables. Never prefix with VITE_ or commit real values.
# This deployment stores Quiz sessions and questions in its dedicated Firebase project.
# At least 32 random characters. Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUIZ_SESSION_SECRET=
# Separate random key (at least 32 characters) for managing Quiz questions.
QUIZ_IMPORT_SECRET=
# Set false to disable the learner-facing question and answer library.
QUIZ_STUDY_ENABLED=true
# Use the Realtime Database URL of your Firebase project.
QUIZ_FIREBASE_DATABASE_URL=https://vnr-game-20261111-default-rtdb.asia-southeast1.firebasedatabase.app
# Firebase service account JSON on one line, server only.
QUIZ_FIREBASE_SERVICE_ACCOUNT=
